Project [Name:&, GUID:GUID]
  Child items:
    ProjectFileImpl(Path : LinkBase.sln)[]

Project [Name:ClassLibrary1, GUID:GUID]
  Child items:
    ProjectFileImpl(Path : ClassLibrary1.fsproj)[]
    Folder [Name:Data, Virtual:../Data, AllowsNonExistence:true]
      Child items:
        Folder [Name:Sub, AllowsNonExistence:true]
          Child items:
            ProjectFileImpl(Path : d.csv)[CONTENT ]
        ProjectFileImpl(Path : a.csv)[CONTENT ]
        ProjectFileImpl(Path : b.csv)[CONTENT ]
    ProjectFileImpl(Path : Library.fs)[COMPILE ]
    Folder [Name:obj, IsHidden:true]
      Child items:
        Folder [Name:Debug, IsHidden:true]
          Child items:
            Folder [Name:net10.0, IsHidden:true]
              Child items:
                ProjectFileImpl(Path : ClassLibrary1.AssemblyInfo.fs)[Hidden COMPILE Properties:CompileOrder=CompileBefore]
                ProjectFileImpl(Path : ILLink.Substitutions.xml)[Hidden EMBEDDEDRESOURCE Properties:LogicalName=ILLink.Substitutions.xml]

