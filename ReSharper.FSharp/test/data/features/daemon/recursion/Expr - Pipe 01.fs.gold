module Module

let rec f1 acc xs =
    match xs with
    | [] -> acc
    | _ :: tail -> tail |> |f1|(0) (acc + 1)

let rec f2 xs =
    match xs with
    | [] -> ()
    | _ :: tail -> tail |> |f2|(1)

let rec f3 acc xs =
    match xs with
    | [] -> acc
    | _ :: tail -> |f3|(2) (acc + 1) <| tail

let rec f4 acc xs =
    match xs with
    | [] -> acc
    | _ :: tail -> (acc + 1, tail) ||> |f4|(3)

let rec f5 acc xs =
    match xs with
    | [] -> acc
    | _ :: tail -> tail |> |f5|(4) (acc + 1) |> id

let rec f6 acc xs =
    match xs with
    | [] -> acc
    | _ :: tail -> tail |> List.map id |> |f6|(5) (acc + 1)

---------------------------------------------------------
(0): Recursion: Recursion in tail position
(1): Recursion: Recursion in tail position
(2): Recursion: Recursion in tail position
(3): Recursion: Recursion in tail position
(4): Non-tail recursion: Recursion in non-tail position
(5): Recursion: Recursion in tail position
