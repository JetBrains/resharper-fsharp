module Module

let rec f1 x =
    try |f1|(0) x with _ -> 0

let rec f2 x =
    try 0 with _ -> |f2|(1) x

let rec f3 x =
    try |f3|(2) x finally ()

---------------------------------------------------------
(0): Non-tail recursion: Recursion in non-tail position
(1): Non-tail recursion: Recursion in non-tail position
(2): Non-tail recursion: Recursion in non-tail position
