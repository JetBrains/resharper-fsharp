module Module

type IA<'T> =
    abstract M2: 'T -> unit
    abstract M1: 'T -> unit

type IB<'U> =
    inherit IA<'U>
    inherit IA<string>

type T<'a>() =
    interface IB<'a> with
        member this.M2(var0: 'a): unit = {selstart}failwith "todo"{selend}
        member this.M1(var0: 'a): unit = failwith "todo"
        member this.M2(var0: string): unit = failwith "todo"
        member this.M1(var0: string): unit = failwith "todo"
