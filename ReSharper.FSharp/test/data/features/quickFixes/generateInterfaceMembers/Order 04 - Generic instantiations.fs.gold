module Module

type IA<'T> =
    abstract M2: 'T -> unit
    abstract M1: 'T -> unit

type IB =
    inherit IA<int>
    inherit IA<string>

type T() =
    interface IB with
        member this.M2(var0: int): unit = {selstart}failwith "todo"{selend}
        member this.M1(var0: int): unit = failwith "todo"
        member this.M2(var0: string): unit = failwith "todo"
        member this.M1(var0: string): unit = failwith "todo"
