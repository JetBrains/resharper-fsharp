module Module

type IA =
    abstract P3: int
    abstract P1: int

type IB =
    inherit IA

    abstract P4: int
    abstract P2: int

type T() =
    interface IB with
        member this.P3 = {selstart}failwith "todo"{selend}
        member this.P1 = failwith "todo"
        member this.P4 = failwith "todo"
        member this.P2 = failwith "todo"
