[<AbstractClass>]
type A() =
    abstract P3: int
    abstract P1: int

[<AbstractClass>]
type B() =
    inherit A()

    abstract P4: int
    abstract P2: int

type C() =
    inherit B()

    override this.P3 = {selstart}failwith "todo"{selend}
    override this.P1 = failwith "todo"
    override this.P4 = failwith "todo"
    override this.P2 = failwith "todo"
